# ==========================================
# n8n 환경 설정 템플릿 — ★ 는 직접 입력할 비밀값
# 사용: cp services/n8n/.env.example services/n8n/.env → ★ 입력 → bin/n8n.sh start
# 값은 따옴표 없이 입력
# 참고: https://eddyglen.com/n8n-korean-language-setup/
# ==========================================

# ==========================================
# 0. 기본 설정
# ==========================================
# 타임존 — 한국 표준시(KST)
GENERIC_TIMEZONE=Asia/Seoul                # 스케줄 트리거·n8n 내부 작업용
TZ=Asia/Seoul                              # 컨테이너 OS·라이브러리용

# 로케일·인코딩 — UTF-8
LANG=ko_KR.UTF-8
LC_ALL=ko_KR.UTF-8

# 백업 경로 — bin/n8n.sh backup 과 백업 워크플로우가 함께 사용
# 비워 두면 프로젝트 루트의 data/backups
# 다른 위치는 절대 경로만 허용 (compose 가 상대 경로를 services/n8n 기준으로 해석)
BACKUP_DIR=

# ==========================================
# 1. n8n 설정
# ==========================================
# n8n 버전 — stable 태그로 고정 (https://github.com/n8n-io/n8n/releases)
# 버전 업그레이드: bin/n8n.sh backup → 값 변경 → bin/n8n.sh restart (새 공식 이미지를 받아 자동 빌드)
N8N_VERSION=2.44.7

# n8n 이미지에 넣을 Node.js 버전 — 공식 이미지의 Node 보안 패치용 (services/n8n/Dockerfile)
# 공식 이미지가 이 버전 이상의 Node 를 담으면 Dockerfile 과 함께 제거
N8N_NODE_VERSION=26.13.1

# 서비스 접속 — N8N_PORT 변경 시 N8N_WEBHOOK_URL 도 함께 수정
# N8N_PORT: 호스트 접속 포트이자 컨테이너 listen 포트
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678

# UI 언어 — 실제 표시는 영어 (공식 이미지에 en 번역만 포함)
# 번역 빌드를 마운트할 때만 적용
N8N_DEFAULT_LOCALE=ko

# ★ n8n API 키 — n8n 첫 실행 후 Settings > n8n API 에서 발급
# .mcp.json 이 읽어 n8n-mcp 에 전달
N8N_API_KEY=

# 크레덴셜 암호화 키 — 분실 시 크레덴셜 복호화 불가, 별도 보관 필수
# n8n_data 볼륨의 config 와 다르면 n8n 시작 실패
# ★ 생성: openssl rand -hex 16 (볼륨 최초 생성 시 1회 설정, 이후 변경 금지)
N8N_ENCRYPTION_KEY=

# Code 노드의 Node.js 내장 모듈 허용 (Buffer, TextDecoder 등)
NODE_FUNCTION_ALLOW_BUILTIN=*

# ==========================================
# 2. DB 설정
# ==========================================
# DB (PostgreSQL) — postgres 계정 생성과 n8n 접속에 같은 값 사용
# 최초 기동 시에만 적용 (이후 비밀번호 변경은 DB 에 미반영)
POSTGRES_USER=n8n
# ★ 생성: openssl rand -hex 16 (비어 있으면 docker compose 시작 거부)
POSTGRES_PASSWORD=
POSTGRES_DB=n8n
