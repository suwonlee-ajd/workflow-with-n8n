    {
      "id": "18b5f003-46c9-4e80-84f3-e8d78d6d215a",
      "name": "후보 고르기",
      "notesInFlow": true,
      "notes": "Why Code: 날짜 5개 응답에서 최신 거래일을 찾고, 종목기본정보와 대조해 보통주만 남기고, 과거 평일 목록을 만드는 일을 기본 노드로 하면 Merge·Filter·Sort·Limit·날짜 생성까지 5개 이상 필요",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        320
      ],
      "parameters": {
        "jsCode": "const cfg = $('실행 설정').first().json;\nconst days = $('최근 시세 가져오기').all()\n  .map(item => item.json)\n  .filter(day => Array.isArray(day.rows) && day.rows.length > 0)\n  .sort((a, b) => a.date.localeCompare(b.date));\nif (!days.length) {\n  throw new Error('최근 5거래일의 국내 시세가 없습니다. KRX 크리덴셜과 서비스 승인 상태를 확인하세요.');\n}\nconst latest = days[days.length - 1];\n\n// 보통주 목록: KRX 종목기본정보. 못 받으면 종목코드·이름 규칙으로 대신함\nconst shortCode = (raw) => {\n  const code = String(raw || '').trim();\n  return /^KR[0-9A-Z]{10}$/.test(code) ? code.slice(3, 9) : code;\n};\nconst common = new Set();\nfor (const nodeName of ['유가증권 종목정보 조회', '코스닥 종목정보 조회']) {\n  const body = $(nodeName).first().json || {};\n  for (const r of Array.isArray(body.OutBlock_1) ? body.OutBlock_1 : []) {\n    const kind = String(r.KIND_STKCERT_TP_NM || '');\n    const section = String(r.SECT_TP_NM || '');\n    const name = String(r.ISU_ABBRV || r.ISU_NM || '');\n    if (kind && !kind.includes('보통주')) continue;\n    if (/SPAC|스팩|관리|투자주의|정리매매/.test(section) || /스팩/.test(name)) continue;\n    common.add(shortCode(r.ISU_SRT_CD || r.ISU_CD));\n  }\n}\nconst filterSource = common.size ? 'KRX 종목기본정보' : '종목코드·이름 규칙';\nconst isCommon = (r) => common.size\n  ? common.has(r.code)\n  : /0$/.test(r.code) && !/스팩|우$|우B$|우C$|[0-9]우/.test(r.name);\n\nconst pool = latest.rows.filter(r => isCommon(r) && r.close >= cfg.minPrice);\npool.sort((a, b) => b.value - a.value);\nconst candidates = pool.slice(0, cfg.candidateCount).map(r => ({ code: r.code, name: r.name, board: r.board, value: r.value }));\n\n// 이동평균 60일을 계산할 만큼 과거 평일 목록을 만듦 (휴장일은 빈 응답)\nconst historyDates = [];\nconst end = DateTime.fromISO(latest.date);\nconst start = end.minus({ days: cfg.historyCalendarDays });\nfor (let d = end; d >= start; d = d.minus({ days: 1 })) {\n  if (d.weekday <= 5) historyDates.push(d.toFormat('yyyy-MM-dd'));\n}\n\nreturn [{ json: { baseDate: latest.date, candidates, historyDates, filterSource, poolSize: pool.length } }];\n"
      }
    },
