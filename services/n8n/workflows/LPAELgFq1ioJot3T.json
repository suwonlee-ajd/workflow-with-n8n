    {
      "id": "68810c31-f7a9-43e0-a300-bf859203429c",
      "name": "국내 시세 정리",
      "notesInFlow": true,
      "notes": "Why Code: Filter·Edit Fields로 나누면 약 2,700종목이 노드마다 복사됨. 응답을 받은 자리에서 필요한 종목·열만 남겨 부모 워크플로우로 넘기는 데이터를 줄임",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        208
      ],
      "parameters": {
        "jsCode": "const input = $('입력 모으기').first().json;\nconst codes = Array.isArray(input.codes) ? input.codes.map(String) : [];\nconst codeSet = codes.length ? new Set(codes) : null;\nconst minValue = Number(input.minValue) || 0;\n// 직접 실행이면 코넥스·지수도 조회돼 있음 (다른 워크플로우가 부를 때는 유가증권·코스닥만)\nconst direct = input.direct === true;\nconst toNum = (v) => {\n  const n = Number(String(v === null || v === undefined ? '' : v).replace(/,/g, '').trim());\n  return Number.isFinite(n) ? n : null;\n};\n// 표준코드(KR7005930003)가 오면 단축코드(005930)로 맞춤\nconst shortCode = (raw) => {\n  const code = String(raw || '').trim();\n  return /^KR[0-9A-Z]{10}$/.test(code) ? code.slice(3, 9) : code;\n};\nconst describe = (body) => `${body.respCode || ''} ${body.respMsg || body.message || (body.error && body.error.message) || JSON.stringify(body).slice(0, 200)}`.trim();\n\nconst boards = [['유가증권 시세 조회', 'KOSPI'], ['코스닥 시세 조회', 'KOSDAQ']];\nif (direct) boards.push(['코넥스 시세 조회', 'KONEX']);\n\nconst rows = [];\nconst errors = [];\nfor (const [nodeName, board] of boards) {\n  const body = $(nodeName).first().json || {};\n  if (!Array.isArray(body.OutBlock_1)) {\n    // 유가증권·코스닥이 없으면 선별을 할 수 없어 멈추고, 코넥스는 건너뜀\n    if (board === 'KONEX') {\n      errors.push(`${nodeName}: ${describe(body)}`);\n      continue;\n    }\n    throw new Error(`${nodeName}: KRX 응답에 시세 목록(OutBlock_1)이 없습니다. ${describe(body)}`);\n  }\n  for (const r of body.OutBlock_1) {\n    const code = shortCode(r.ISU_SRT_CD || r.ISU_CD);\n    if (!code || (codeSet && !codeSet.has(code))) continue;\n    const close = toNum(r.TDD_CLSPRC);\n    const value = toNum(r.ACC_TRDVAL) || 0;\n    if (!close || value < minValue) continue;\n    rows.push({\n      code,\n      name: String(r.ISU_NM || r.ISU_ABBRV || '').trim(),\n      board,\n      close,\n      changePct: toNum(r.FLUC_RT),\n      volume: toNum(r.ACC_TRDVOL) || 0,\n      value,\n    });\n  }\n}\n\nconst result = { date: input.date, rows };\nif (direct) {\n  // 지수: 외국주포함 지수처럼 종가가 비어 있는 행은 뺌\n  const indices = [];\n  for (const nodeName of ['KRX 지수 조회', 'KOSPI 지수 조회', 'KOSDAQ 지수 조회']) {\n    const body = $(nodeName).first().json || {};\n    if (!Array.isArray(body.OutBlock_1)) {\n      errors.push(`${nodeName}: ${describe(body)}`);\n      continue;\n    }\n    for (const r of body.OutBlock_1) {\n      const close = toNum(r.CLSPRC_IDX);\n      if (!close) continue;\n      indices.push({ group: String(r.IDX_CLSS || ''), name: String(r.IDX_NM || '').trim(), close, changePct: toNum(r.FLUC_RT) });\n    }\n  }\n  result.indices = indices;\n  result.errors = errors;\n}\n\nreturn [{ json: result }];\n"
      }
    },
